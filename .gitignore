# -----------------------------------------------------------------------------
# Uinxed-Agent: files that must stay local / generated
# -----------------------------------------------------------------------------

# Built binaries and release output
/ux-agent
/ux-agent.exe
/bin/
/build/
/dist/
/release/
*.test
*.out

# Go test / coverage / profiling output
/coverage.out
/coverage-*.out
/coverage.html
*.prof
*.trace
/benchmark.txt
/benchmark-*.txt

# Local runtime state (the normal app state lives under ~/.config/ux-agent)
/.uinxed/
/.ux-agent/
/config.json
/ux-agent.db
/ux-agent.db-shm
/ux-agent.db-wal
/logs/
*.log

# Local environment / credentials
.env
.env.*
!.env.example

# Temporary files
*.tmp
*.temp
*.bak
*.swp
*.swo
*~

# Editors / IDEs
.vscode/
.idea/

# OS metadata
.DS_Store
Thumbs.db

# Legacy Node.js artifacts must never return to the Go rewrite
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
dist-js/

# Delivery-only checksum manifest; release.yml generates SHA256SUMS.txt itself
/MANIFEST.sha256
